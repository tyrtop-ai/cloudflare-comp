{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qwen-control-plane-v4",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ControlRoom"
      },
      {
        "name": "MANAGERS",
        "class_name": "ManagerShard"
      },
      {
        "name": "BUILD_EXECUTORS",
        "class_name": "BuildExecutor"
      },
      {
        "name": "BENCHES",
        "class_name": "BenchRun"
      },
      {
        "name": "BOXES",
        "class_name": "Box"
      },
      {
        "name": "BOX_PROBES",
        "class_name": "BoxProbe"
      }
    ]
  },
  "exports": {
    "ControlRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ManagerShard": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BuildExecutor": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BenchRun": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Box": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "BoxProbe": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "MODEL_NAME": "@cf/qwen/qwen3-30b-a3b-fp8",
    "MOCK_AI": "false",
    "BENCH_EXECUTORS": "4",
    "BOX_CONCURRENCY": "4",
    "BOX_PROBE": "0"
  },
  "containers": [
    {
      "class_name": "BuildExecutor",
      "image": "./container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 4
    },
    {
      "class_name": "Box",
      "scheduling_policy": "durable_object",
      "images": {
        "check": {
          "dockerfile": "./container/Dockerfile.box",
          "build_context": "./container",
          "build_vars": {
            "BOX_BROWSER": "0"
          }
        },
        "browser": {
          "dockerfile": "./container/Dockerfile.box",
          "build_context": "./container",
          "build_vars": {
            "BOX_BROWSER": "1"
          }
        },
        "fetch": {
          "dockerfile": "./container/Dockerfile.fetch",
          "build_context": "./container"
        }
      }
    }
  ]
}
