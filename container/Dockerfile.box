# Capability boxes (S0/S1): the `check` and `browser` images of the Box
# Container application (wrangler.jsonc, scheduling_policy durable_object).
# One Dockerfile, two images: BOX_BROWSER=1 adds Playwright's Chromium
# headless shell. An agent's session (src/box-session.js) writes its files
# into /work and runs its commands there, as the box's root, with the
# internet on: it installs whatever else it needs. iputils-ping is here for
# the S0 probe's ICMP question only; /opt/box/hostname.py runs a command
# under the box's own short host name (box-<16 hex>), which the probe
# reports: the platform's name has a label over 63 characters, on which
# Python's socket.getfqdn (http.server) fails.
FROM node:lts-bookworm-slim
ARG BOX_BROWSER=0
# What the image has from the start, so a session that needs one of these
# does not wait for its install (owner 2026-10-15 05:16, "Any code type").
# Channels only, no versions pinned.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pytest python3-pip ca-certificates iputils-ping \
    golang-go gcc g++ libc6-dev default-jdk-headless ruby php-cli rustc cargo rustfmt maven composer unzip \
 && rm -rf /var/lib/apt/lists/*
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright NODE_PATH=/usr/local/lib/node_modules
RUN if [ "$BOX_BROWSER" = "1" ]; then npm install -g playwright && playwright install --with-deps --only-shell chromium \
 && rm -rf /root/.npm /root/.cache /var/lib/apt/lists/*; fi \
 && mkdir -p /ms-playwright
RUN command -v timeout && command -v unshare && command -v nsenter && command -v prlimit && useradd --create-home --uid 10001 builder
COPY box/probe.mjs box/hostname.py /opt/box/
RUN chmod 0444 /opt/box/probe.mjs /opt/box/hostname.py && chmod -R a+rX /opt/box /ms-playwright \
 && mkdir -p /work && chown builder:builder /work
USER builder
WORKDIR /work
CMD ["sleep", "infinity"]
